# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env) - EL BODEGÓN DE LOS TRAJES (2026)
# ==============================================================================
# Instrucciones para la VPS:
# 1. Copia este archivo con: cp .env.example .env
# 2. Ajusta las credenciales y puertos según tu entorno.
# 3. Levanta los contenedores con: docker compose up -d --build
# ==============================================================================

# --- PUERTO DEL CONTENEDOR EN EL HOST ---
# Puerto local que mapeará el contenedor Nginx+PHP (por defecto 8095)
PORT=8095

# --- CREDENCIALES DEL PANEL DE ADMINISTRACIÓN ---
# Usuario para iniciar sesión en /admin o /api/auth
ADMIN_USER=Ana Avila

# Contraseña en texto plano (se comparará de forma segura con hash_equals)
ADMIN_PASS=ANAISABEL2026

# Opcional (Recomendado para máxima seguridad): Hash bcrypt generado con password_hash().
# Si se define ADMIN_PASSWORD_HASH, tendrá prioridad sobre ADMIN_PASS.
ADMIN_PASSWORD_HASH=

# --- INTEGRACIÓN CON GITHUB API (OPCIONAL) ---
# Token de acceso personal (PAT) de GitHub con permiso "repo".
# Necesario ÚNICAMENTE si quieres que los cambios guardados desde el panel web
# se sincronicen automáticamente como commits en tu repositorio de GitHub.
# Si lo dejas vacío, el sitio guarda cambios locales en el servidor sin problema.
GITHUB_TOKEN=

# Repositorio y rama de destino
GITHUB_REPO=avilamateito818-sudo/EL-BODEGON-DELOS-TRAJES-20262
GITHUB_BRANCH=main

# --- INFORMACIÓN DE CONTACTO Y WHATSAPP ---
# Número de teléfono para el botón de WhatsApp (formato internacional sin signos, ej: 573107706615)
CONTACT_PHONE=573107706615

# Correo de contacto del negocio
CONTACT_EMAIL=elbodegondelostrajes@gmail.com
