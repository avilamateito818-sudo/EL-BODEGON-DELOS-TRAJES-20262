# Normalización de saltos de línea
* text=auto

# Archivos binarios (no tocar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary

# Código y texto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
